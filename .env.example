# Where KVARK is. The gateway is the only thing this application really talks to; the
# internal API is used for exactly one call — exchanging a person's credentials for a
# token — and drops out entirely once the directory exchange lands.
KVARK_GATEWAY_BASE=http://host.docker.internal:8010/agent-api/v1
KVARK_API_BASE=http://host.docker.internal:8008/api

# Verify KVARK's TLS certificate. Leave it alone for anything real. A rack PR preview
# serves a self-signed certificate naming only localhost and 127.0.0.1, so verification
# fails there on both the chain and the address — set this to false to talk to one.
KVARK_VERIFY_TLS=true

# What this agent calls itself. The slug derived from the name is permanent.
AGENT_NAME=Egzakta Console
AGENT_VERSION=1.0.0

# Declared to KVARK only when it is reachable from the public internet over https.
# A local run leaves this empty and is simply never probed, which is not an error.
AGENT_HEALTH_URL=

# How often the chat console asks whether a turn has settled. A second or two, not a tight loop.
AGENT_POLL_SECONDS=2

# Used by scripts/kvark_admin.py only — the administrator's side of the flow.
KVARK_ADMIN_USER=admin
KVARK_ADMIN_PASSWORD=admin
